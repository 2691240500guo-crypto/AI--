# 必填：团队环境仍使用云端 MySQL，真实地址和凭据只写入本机 .env。
DATABASE_URL=mysql+pymysql://<user>:<password>@<cloud-mysql-host>:3306/<database>
SECRET_KEY=<generate-a-long-random-secret>

# Redis 使用每位成员本机的服务；MySQL 仍连接团队云数据库。
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
# 每位成员建议使用不同前缀，例如 ai_talent:dev:zhangsan。
REDIS_KEY_PREFIX=ai_talent:dev:<member>
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_COUNT=2
REDIS_ANALYTICS_TTL=600
REDIS_DISTRIBUTION_TTL=1800
REDIS_AUTH_TTL=1800
REDIS_NAVIGATION_TTL=3600
REDIS_HOME_TTL=60
REDIS_MESSAGE_TTL=15
REDIS_LOCK_TTL=60
REDIS_LOGIN_RATE_LIMIT=10
REDIS_LOGIN_RATE_WINDOW=300
REDIS_AI_RATE_LIMIT=10
REDIS_AI_RATE_WINDOW=60
