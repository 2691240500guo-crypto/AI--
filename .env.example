# ===== 复制为 .env 并按需修改 =====
# 数据库连接（默认本地 MySQL8；云端示例见 README）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/ai_talent?charset=utf8mb4
# SQLite 备选：sqlite:///./dev.db

# 云端 MySQL 连接参数（与 DATABASE_URL 二选一填写；env.py 优先读 DATABASE_URL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ai_talent

SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许来源（管理端/小程序请求域名），逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Redis（限流/缓存；无则本地降级）
REDIS_URL=redis://localhost:6379/0

# ===== AI 基建（按需启用，依赖惰性加载）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

MILVUS_HOST=localhost
MILVUS_PORT=19530

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-talent
